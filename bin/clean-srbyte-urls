#!/usr/bin/env python3
import os
import sys

def clean_file(file_path):
    try:
        with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()
            
        original = content
        
        # Replacements for URLs with trailing slash
        content = content.replace('https://www.srbyte.com/', '/')
        content = content.replace('https://srbyte.com/', '/')
        content = content.replace('http://www.srbyte.com/', '/')
        content = content.replace('http://srbyte.com/', '/')
        
        # Replacements for URLs without trailing slash
        content = content.replace('https://www.srbyte.com', '/')
        content = content.replace('https://srbyte.com', '/')
        content = content.replace('http://www.srbyte.com', '/')
        content = content.replace('http://srbyte.com', '/')
        
        if content != original:
            with open(file_path, 'w', encoding='utf-8') as f:
                f.write(content)
            return True
    except Exception as e:
        print(f"Error processing {file_path}: {e}", file=sys.stderr)
    return False

def main():
    target_dir = "content/writings/srbyte"
    if not os.path.isdir(target_dir):
        print(f"Error: Directory '{target_dir}' not found.", file=sys.stderr)
        sys.exit(1)
        
    print(f"Cleaning srbyte.com URLs in '{target_dir}'...")
    modified_count = 0
    
    for root, _, files in os.walk(target_dir):
        for file in files:
            if file.endswith('.md'):
                full_path = os.path.join(root, file)
                if clean_file(full_path):
                    print(f"  Cleaned: {full_path}")
                    modified_count += 1
                    
    print(f"\nCompleted. Cleaned {modified_count} files.")

if __name__ == '__main__':
    main()
